# Firebase Realtime Database (opcional).
# Copia este archivo a .env.local y rellena la URL de tu instancia.
# Sin esta variable la app funciona igual, pero la nube queda desactivada.
# La app usa la API REST por HTTPS (sin SDK): solo necesita la URL de la base.
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
